# Copy to server/.env and fill in. Never commit the real file.
PORT=5000
NODE_ENV=development

# Primary PostgreSQL (users, papers, exams, sessions, templates...)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DIRECT_DATABASE_URL=

# Auth
JWT_SECRET=            # long random string
JWT_EXPIRES_IN=10h
ADMIN_PASSWORD=        # password of the built-in admin account

# Subject question databases (one per subject and class)
DB_MATH_11_URL=
DB_MATH_12_URL=
DB_CHEM_11_URL=
DB_CHEM_12_URL=
DB_BIO_11_URL=
DB_BIO_12_URL=
DB_PHY_11_URL=
DB_PHY_12_URL=

# QBP control (previous-year / grand-test questions)
DB_QBP_CONTROL_URL=
DB_QBP_CONTROL_KEY=

# Optional
MONGO_URI=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Browser access: comma-separated front-end origins (unset or * allows every origin with credentials)
ALLOWED_ORIGINS=

# Lab terminal login (CBT). Required: lab login is refused until both are set.
LAB_ID=
LAB_PASSWORD=
# Comma-separated public IP address(es) of the lab network. If unset, any address may reach the lab endpoints.
LAB_IP=

# PEM text (use \n) or path of the database provider CA certificate; enables certificate verification
DB_SSL_CA=
# Only for `npm run init:db`: password for starter faculty accounts (omit to skip seeding them)
SEED_FACULTY_PASSWORD=
